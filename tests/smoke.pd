#N canvas 40 40 640 520 10;
#X obj 20 20 loadbang;
#X obj 20 50 t b b b;
#X msg 300 90 \; ir 0 1;
#X msg 160 90 \; pd dsp 1;
#X obj 20 90 del 300;
#X obj 20 130 t b b;
#X obj 20 260 snapshot~;
#X obj 20 300 print OUT;
#X obj 160 170 s cv;
#X msg 160 130 set ir;
#X obj 20 340 del 300;
#X msg 20 380 \; pd quit;
#X obj 420 200 table ir 64;
#X obj 20 200 sig~ 0.5;
#X obj 20 230 convolution~ ir;
#X obj 300 200 r cv;
#X text 300 20 An impulse response of one sample at 1.0 is the identity \,
so a constant 0.5 in has to come back as 0.5.;
